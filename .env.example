# ── Database ──────────────────────────────────────────────────────────
# SQLite (development, zero setup):
DATABASE_URL=sqlite:///./clearance.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/clearance_db

# ── Security ──────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_MINIMUM_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI (OpenAI) ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-openai-key...

# ── Email Notifications ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=ClearanceSystem <your@gmail.com>

# ── File Storage ───────────────────────────────────────────────────────
UPLOAD_DIR=uploads
CERT_DIR=certificates
MAX_UPLOAD_MB=10

# ── University Branding ───────────────────────────────────────────────
UNIVERSITY_NAME=University of Nigeria
UNIVERSITY_SHORTNAME=UNN
